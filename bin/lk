#!/bin/sh
# lanekeeper lk: 플러그인 bin/ 이라 플러그인이 켜져 있으면 Bash 도구 PATH 에 오른다. 본체는 scripts/lk.py 다.
# Python 은 LANEKEEPER_PYTHON, python3, python 순으로 3.8 이상인 것을 쓴다(Windows 의 python3 가짜 별칭은 건너뛴다).
here=$(cd "$(dirname "$0")/.." && pwd)
for py in "$LANEKEEPER_PYTHON" python3 python; do
  if [ -n "$py" ] && "$py" -c 'import sys; sys.exit(sys.version_info < (3, 8))' >/dev/null 2>&1; then
    exec "$py" "$here/scripts/lk.py" "$@"
  fi
done
echo 'lk: Python 3.8 이상을 찾지 못했다. LANEKEEPER_PYTHON 에 python 경로를 넣는다' >&2
exit 127
