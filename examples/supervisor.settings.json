{
  "env": {
    "LANEKEEPER_HUB_DIR": "<허브 폴더>",
    "LANEKEEPER_MAX_TASKS": "8"
  },
  "permissions": {
    "allow": [
      "Bash(lk spawn *)",
      "Bash(lk close *)",
      "Bash(claude agents *)",
      "Bash(claude logs *)",
      "Bash(claude stop *)",
      "Bash(git push origin *)",
      "Read(<레인 저장소들의 상위 폴더>/**)",
      "Edit(<레인 저장소들의 상위 폴더>/*/.claude/worktrees/**)",
      "Write(<레인 저장소들의 상위 폴더>/*/.claude/worktrees/**)"
    ],
    "deny": [
      "Bash(claude --bg *)",
      "Bash(claude --background *)",
      "Bash(claude * --bg *)",
      "Bash(claude * --bg)",
      "Bash(claude * --background *)",
      "Bash(claude * --background)",
      "Bash(claude rm *)",
      "Bash(git push --force*)",
      "Bash(git push * main*)",
      "Bash(git push * master*)"
    ]
  },
  "autoMode": {
    "allow": [
      "<슈퍼바이저 세션(이름이 -supervisor 로 끝나고 허브가 lk spawn -- --settings <허브 폴더>/supervisor.settings.json 으로 띄운 세션)에 사용자가 허락한 일을 문장으로 적습니다. 할 수 있는 것(예: 개발 환경 시험, 기능 브랜치 push, lk spawn 으로 하위 세션 2개까지, 전체 작업 세션 상한은 lk spawn 이 지킴)과 못 하는 것(예: main 직접 push, force push, 운영 반영, 비밀값 출력)을 함께 씁니다.>"
    ]
  }
}
