{
  "model": "claude-opus-5-5",
  "effortLevel": "high",
  "env": {
    "LANEKEEPER_MAX_TASKS": "8"
  },
  "permissions": {
    "allow": [
      "Bash(lk spawn *)",
      "Bash(lk close *)",
      "Bash(claude agents *)",
      "Bash(claude logs *)",
      "Bash(claude stop *)",
      "Bash(claude respawn *)"
    ],
    "deny": [
      "Bash(claude --bg *)",
      "Bash(claude --background *)",
      "Bash(claude * --bg *)",
      "Bash(claude * --bg)",
      "Bash(claude * --background *)",
      "Bash(claude * --background)",
      "Bash(claude rm *)",
      "Edit(~/projects/<레인 저장소 1>/**)",
      "Edit(~/projects/<레인 저장소 2>/**)"
    ],
    "additionalDirectories": [
      "<레인 저장소들의 상위 폴더>"
    ]
  }
}
