{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/open_dashboard.py"
            ],
            "timeout": 40,
            "statusMessage": "에이전트 대시보드 확인 중"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/lane_guard.py",
              "${user_config.lane_message_hub_only}"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/git-message-style.py",
              "${user_config.git_message_check}"
            ],
            "timeout": 10,
            "statusMessage": "커밋 문구 규칙 검사"
          }
        ]
      }
    ]
  }
}
